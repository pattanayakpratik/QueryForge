# Environment Variables for QueryForge

# Application
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database Configuration
# Internal metadata store (PostgreSQL or SQLite for local dev)
METADATA_DATABASE_URL=sqlite+aiosqlite:///./queryforge_metadata.db
# Target DB for demo / introspection (can be SQLite or Postgres)
TARGET_DATABASE_URL=sqlite+aiosqlite:///./ecommerce_demo.db

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# ChromaDB / Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Security & Execution Limits
MAX_EXECUTION_COST=50000
MAX_SELF_HEAL_ATTEMPTS=3
STATEMENT_TIMEOUT_MS=5000
DEFAULT_ROW_LIMIT=500
